{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Source and atomic Knowledge. Knowledge revisions and software versions in JSONB scope are independent. Save requires idempotency_key; Knowledge requires scope, sources, reason, and expected_revision when id is supplied.",
    "title": "Epivra",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          },
          "503": {
            "description": "not ready"
          }
        },
        "security": []
      }
    },
    "/readyz": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          },
          "503": {
            "description": "not ready"
          }
        },
        "security": []
      }
    },
    "/v1/read": {
      "post": {
        "operationId": "read",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "attachment_id": {
                    "type": "string"
                  },
                  "history": {
                    "type": "boolean"
                  },
                  "id": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "offset": {
                    "type": "integer"
                  },
                  "revision": {
                    "type": "integer"
                  },
                  "type": {
                    "enum": [
                      "source",
                      "knowledge"
                    ],
                    "type": "string"
                  },
                  "workspace_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "workspace_id",
                  "type",
                  "id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "400": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "401": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "403": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "404": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "409": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "413": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "500": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          }
        }
      }
    },
    "/v1/save": {
      "post": {
        "operationId": "save",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "attachments": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "data": {
                          "type": "string"
                        },
                        "mime": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "mime",
                        "data"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "body": {
                    "type": "string"
                  },
                  "conditions": {
                    "type": "string"
                  },
                  "expected_revision": {
                    "type": "integer"
                  },
                  "id": {
                    "type": "string"
                  },
                  "idempotency_key": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  "metadata": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "provenance": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "scope": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "source_time": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "sources": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "tags": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "type": {
                    "enum": [
                      "source",
                      "knowledge"
                    ],
                    "type": "string"
                  },
                  "workspace_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "workspace_id",
                  "type",
                  "body",
                  "idempotency_key"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "400": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "401": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "403": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "404": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "409": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "413": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "500": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "operationId": "search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "limit": {
                    "type": "integer"
                  },
                  "offset": {
                    "type": "integer"
                  },
                  "query": {
                    "type": "string"
                  },
                  "scope": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "since": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "tags": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "types": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "workspace_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "workspace_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "400": {
            "description": "200: data, warnings and optional page; errors: error.code, error.message and optional error.details"
          },
          "401": {

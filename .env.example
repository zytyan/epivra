# Inject these into the process environment. The binary does not auto-load .env.
DATABASE_URL='postgres://knowledgehub:replace_me@127.0.0.1:5432/knowledgehub?sslmode=disable'
LISTEN_ADDR=127.0.0.1:8080
MCP_READ_PATH=/mcp
MCP_WRITE_PATH=/mcp/write
# Exact comma-separated browser origins. CLI clients without Origin are accepted.
TRUSTED_ORIGINS=
MAX_UPLOAD_BYTES=20971520
